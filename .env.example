# 复制成 .env 并按需修改；cmd/api/main.go 与测试 helper 都读这些变量的默认值。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=seckill
DB_PASSWORD=seckill
DB_NAME=seckill
NODE_ID=1
HTTP_ADDR=:8080

# 集成测试用（testutil.OpenTestDB），一般和上面 DB_* 一致即可
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=seckill
TEST_DB_PASSWORD=seckill
TEST_DB_NAME=seckill
